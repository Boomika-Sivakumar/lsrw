# ===== LSRW AI Platform - Environment Variables =====
# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Core ---
APP_NAME="LSRW Communication AI"
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Defaults to SQLite for local development (no server needed).
# For MySQL (production / Docker) uncomment and use:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=lsrw_ai
# DB_USER=root
# DB_PASSWORD=your_password
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/lsrw_ai
DATABASE_URL=sqlite:///./dev.db

# --- AI Providers ---
# Which provider to use: development | openrouter | openai_compatible
AI_PROVIDER=development

# Speech-to-text provider: development | whisper
STT_PROVIDER=development

# For OpenRouter (Free AI Models):
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-v1-your-openrouter-api-key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.2-1b-instruct:free
# Free OpenRouter Models:
# - meta-llama/llama-3.2-1b-instruct:free
# - google/gemma-2-9b-it:free
# - deepseek/deepseek-r1:free
# - qwen/qwen-2.5-7b-instruct:free

# For OpenAI:
# AI_PROVIDER=openai_compatible
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini


# Whisper / local speech engine path (optional)
# WHISPER_MODEL=base

# --- WebRTC / signaling ---
# WebRTC uses WebSocket signaling. STUN/TURN servers for production:
# WEBRTC_STUN=stun:stun.l.google.com:19302

# --- Storage ---
# Where uploaded audio / recordings are stored.
STORAGE_DIR=storage
MAX_UPLOAD_MB=50
